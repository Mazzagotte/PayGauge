{
  "name": "paygauge",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/paygauge-web",
    "packages/*"
  ],
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-local.ps1",
    "dev:phone": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-phone.ps1",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android.ps1",
    "dev:web": "npm --workspace apps/paygauge-web run dev",
    "build:web": "npm --workspace apps/paygauge-web run build"
  }
}
